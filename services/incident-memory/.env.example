SERVICE_NAME=incident-memory
SERVICE_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Local learning/development storage. Use PostgreSQL for team integration.
DATABASE_URL=sqlite:///./data/memory.db
# Live is the default; mock must be chosen explicitly.
M5_UI_MODE=live
SHARED_NEXUS_API_BASE_URL=http://localhost:8000
# These are the M5 adapter defaults, not existing/frozen shared API contracts.
M5_INCIDENTS_PATH=/api/incidents
M5_INCIDENT_DETAIL_PATH=/api/incidents/{incident_id}
# Leave unset until M4/shared core agree on the approval endpoint and payload.
M5_APPROVAL_PATH=
M5_SHARED_API_TOKEN=
# Optional shared-core read route. Must return source=real and a services list.
M5_SERVICE_HEALTH_PATH=
# Optional M4 route that creates a PENDING approval request, never executes it.
M5_ACTION_REQUEST_PATH=
# Optional shared-core read adapters. Leave blank until routes are agreed after merge.
M5_SERVICES_PATH=
M5_TELEMETRY_PATH=
M5_DEPLOYMENTS_PATH=
M5_FINOPS_PATH=
M5_LOGS_PATH=
# Must contain {request_id}; read-only M4 request/execution/recovery status.
M5_ACTION_STATUS_PATH=
# Open-ended AI chat; keys stay on the backend. Set a real key locally, never commit it.
M5_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
M5_LLM_MODEL=gemini-3.8-flash
M5_LLM_API_KEY=
# GEMINI_API_KEY is also accepted for Gemini. Compatible local servers can omit the key.
