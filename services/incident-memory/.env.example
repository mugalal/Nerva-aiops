SERVICE_NAME=incident-memory
SERVICE_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Local learning/development storage. Use PostgreSQL for team integration.
DATABASE_URL=sqlite:///./data/memory.db
# Live is the default; mock must be chosen explicitly.
M5_UI_MODE=live
SHARED_NEXUS_API_BASE_URL=http://localhost:8000
# These are the M5 adapter defaults, not existing/frozen shared API contracts.
M5_INCIDENTS_PATH=/api/incidents
M5_INCIDENT_DETAIL_PATH=/api/incidents/{incident_id}
# Leave unset until M4/shared core agree on the approval endpoint and payload.
M5_APPROVAL_PATH=
M5_SHARED_API_TOKEN=
